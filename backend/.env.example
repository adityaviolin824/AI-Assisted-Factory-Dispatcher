# Copy this file to backend/.env and fill in the values. Git ignores backend/.env.
# A variable already set in the environment takes precedence over this file.

# Needed only for paid model calls: processing a request that has no saved answer, and voice input.
OPENAI_API_KEY=

# Optional LangSmith tracing of pipeline runs. Keep it false unless you have a LangSmith API key.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# LangSmith uses its "default" project when this is not set.
# LANGSMITH_PROJECT=

# ALLOW_PAID_PROCESSING does not belong here: the API checks it before it reads this file.
# Set it when starting the server instead: ALLOW_PAID_PROCESSING=1 uv run fastapi dev main.py
