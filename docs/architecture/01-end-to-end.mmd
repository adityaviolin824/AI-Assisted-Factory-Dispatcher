flowchart TB
    subgraph FE["FRONTEND - intended three-page product"]
        direction TB
        PEOPLE["Multiple operations users"]
        CHAT["Group-chat requests and corrections<br/>CURRENT: one shared room<br/>PLANNED: live channels"]
        LAND["Landing / demo - PLANNED<br/>Actual capabilities and measured results"]
        PEOPLE --> CHAT
    end

    subgraph IN["INGESTION AND STORAGE"]
        direction TB
        CAPTURE["Capture text, sender, time and identity<br/>CURRENT: mock capture<br/>PLANNED: live API"]
        MESSAGES[("Message history<br/>CURRENT: SQLite<br/>PLANNED: channel-aware records")]
        ENTRY["Processing entry<br/>CURRENT: manual TXT snapshot<br/>PLANNED: live intake queue"]
        CAPTURE --> MESSAGES --> ENTRY
    end
    CHAT --> CAPTURE

    subgraph LG["LANGGRAPH - workflow state, named nodes and conditional edges"]
        INTAKE["Extract and link - CURRENT<br/>LLM proposals; source checks"]
        VERIFY["Verify current tasks - CURRENT<br/>Trusted facts and readiness"]
        ROUTE{"Validated outcome?"}
        WAIT["Clarification / review<br/>CURRENT: recorded questions<br/>PLANNED: persistent human wait"]
        INFO["Information / unsupported outcome<br/>PLANNED: grounded response<br/>No allocation"]
        ALLOC["Python allocator - CURRENT<br/>Eligibility, feasibility and ranking"]
        RECORD["Decision preview - CURRENT<br/>Metrics, alternatives and reasons<br/>Related uncertainty adds provisional warnings"]
        HUMAN["Feedback / resume - PLANNED<br/>Same request and current version"]
        COMMIT["Commit service - PLANNED<br/>Recheck; assign atomically"]
        INTAKE --> VERIFY --> ROUTE
        ROUTE -->|Missing facts or unresolved interpretation| WAIT
        WAIT -->|Validated reply; invalidate old checks| VERIFY
        ROUTE -->|Information or unsupported intent| INFO
        ROUTE -->|Ready allocation task| ALLOC --> RECORD --> HUMAN
        HUMAN -->|Changed facts or constraints| VERIFY
        HUMAN -->|Confirmation under agreed approval policy| COMMIT
    end
    ENTRY --> INTAKE

    DATA[("Trusted source data<br/>orders.csv / workshops.csv")]
    WORK[("Workflow and decision store<br/>CURRENT: manifest, state, calls and plan JSON<br/>PLANNED: durable checkpoints")]
    QUEUES[("Assignments and queues - PLANNED<br/>Committed reservations and history")]
    DATA -.->|Exact lookup| VERIFY
    DATA -.->|Workshop profiles| ALLOC
    QUEUES -.->|Current queue and assignment snapshot| ALLOC
    RECORD --> WORK
    WAIT -.->|Persist wait| WORK
    HUMAN -.->|Audit feedback| WORK
    COMMIT --> QUEUES

    subgraph DC["DISPATCHER CONSOLE - PLANNED; one authoritative dispatcher"]
        direction TB
        CONSOLE["Unified dispatcher work list<br/>Evidence, blockers and alternatives"]
        DISPATCHER["Human dispatcher<br/>Resolve, confirm or reject"]
        ASSIST["Grounded explanation assistant<br/>Use stored facts and code metrics"]
        CONSOLE --> DISPATCHER
        CONSOLE --> ASSIST
    end
    WORK --> CONSOLE
    DISPATCHER -->|Feedback with task identity| HUMAN
    DISPATCHER -->|Resolve review| WAIT
    WORK -.->|Recorded decision evidence| ASSIST
    ASSIST -->|New comparison or what-if needs code| HUMAN

    OUT["Publish outcome - PLANNED<br/>Dispatcher view and originating chat<br/>Assignment instruction after commit"]
    COMMIT --> OUT
    INFO --> OUT
    HUMAN -->|Reject or cancel; retain any existing assignment| OUT

    EVAL["Separate evaluation<br/>120-order replay and 30-request checks<br/>Official versus external metrics"]
    ALLOC -.->|Same deterministic core; different adapters| EVAL
    WORK -.->|Evidence and traces| EVAL

    classDef frontend fill:#e6f0ff,stroke:#3773b9,color:#142e51;
    classDef langgraph fill:#eee7fb,stroke:#7750ad,color:#382454;
    classDef code fill:#e1f3ed,stroke:#27806a,color:#163f35;
    classDef human fill:#fff0d5,stroke:#b27a22,color:#563b15;
    classDef store fill:#edf0f4,stroke:#718096,color:#293444;
    classDef planned stroke-dasharray:5 4;
    class PEOPLE,CHAT,LAND,CONSOLE,OUT frontend;
    class INTAKE,VERIFY,ROUTE,HUMAN,WAIT langgraph;
    class CAPTURE,ENTRY,ALLOC,COMMIT,INFO,ASSIST,EVAL code;
    class DISPATCHER human;
    class MESSAGES,DATA,WORK,QUEUES,RECORD store;
    class LAND,CONSOLE,OUT,HUMAN,WAIT,COMMIT,ASSIST,QUEUES planned;
    style LG fill:#f7f2ff,stroke:#7750ad,stroke-width:2px
    style FE fill:#f5f9ff,stroke:#b4c9e2
    style IN fill:#f7f8fa,stroke:#c1c9d4
    style DC fill:#fff9ee,stroke:#d7b579,stroke-dasharray:5 4
