flowchart TB
    USERS["Multiple participants in separate browser sessions"]
    CHAT["CURRENT shared Streamlit chat room<br/>Self-entered names, message composer and shared timeline"]
    SESSION["Per-browser session<br/>Name, unsent draft, retry identity and export display"]
    DB[("CURRENT shared SQLite message database<br/>Original text, sender and receipt time<br/>Database sequence orders messages<br/>Submission identity handles same-event retries")]
    EXPORT["User explicitly exports full conversation<br/>One captured database snapshot<br/>New messages and earlier exports are retained"]
    TXT[("TXT snapshot and companion manifest<br/>One physical line per message<br/>Mapping to database messages and notebook line IDs<br/>Original multiline text retained separately")]
    MANUAL["MANUAL: configure TXT input and run run_full_pipeline.py<br/>The chat does not invoke the graph automatically"]
    subgraph LG["CURRENT LANGGRAPH MODULE - six nodes and one conditional router"]
        BEGIN(("START"))
        START["start_run<br/>Create a fresh run; exact requests may hit cache"]
        LINK["link_items<br/>Process pending jobs; an initial fresh pass has none"]
        MORE{"after_link<br/>Unread messages?"}
        EXTRACT["extract_batch<br/>Extract and source-check the next owned batch"]
        VERIFY["verify_tasks<br/>Check current task versions after all input is read"]
        SAVE["save_outputs<br/>Save state, reviews and message accounting"]
        ALLOC["plan_allocation<br/>Use same-run state; make deterministic EDD preview<br/>Label provisional warnings and partial processing"]
        ENDNODE(("END"))
        BEGIN --> START --> LINK --> MORE
        MORE -->|Yes| EXTRACT --> LINK
        MORE -->|No| VERIFY --> SAVE --> ALLOC --> ENDNODE
    end
    FILES[("CURRENT processing run files<br/>Input/settings manifest, state.json and calls/<br/>Task versions, source evidence and review records<br/>Shared exact-request response cache")]
    PLAN[("CURRENT saved allocation plan<br/>Tentative queue changes and decision evidence<br/>No committed assignment or live reservation")]
    FUTURE["PLANNED live product<br/>Multiple channels, API intake and durable human waits<br/>Dispatcher console, grounded assistant and atomic assignments"]
    USERS --> CHAT --> DB --> EXPORT --> TXT --> MANUAL --> BEGIN
    CHAT -.-> SESSION
    SESSION -.->|Same-event retry identity| DB
    START -.-> FILES
    SAVE --> FILES
    FILES -.->|Standalone allocator can load an explicitly named run| ALLOC
    ALLOC --> PLAN
    PLAN -.->|Future integration boundary| FUTURE

    classDef frontend fill:#e6f0ff,stroke:#3773b9,color:#142e51;
    classDef langgraph fill:#eee7fb,stroke:#7750ad,color:#382454;
    classDef code fill:#e1f3ed,stroke:#27806a,color:#163f35;
    classDef human fill:#fff0d5,stroke:#b27a22,color:#563b15;
    classDef store fill:#edf0f4,stroke:#718096,color:#293444;
    classDef planned stroke-dasharray:5 4;
    class USERS,CHAT,FUTURE frontend;
    class BEGIN,START,LINK,MORE,EXTRACT,VERIFY,SAVE,ENDNODE langgraph;
    class EXPORT,ALLOC code;
    class MANUAL human;
    class SESSION,DB,TXT,FILES,PLAN store;
    class FUTURE planned;
    style LG fill:#f7f2ff,stroke:#7750ad,stroke-width:2px
