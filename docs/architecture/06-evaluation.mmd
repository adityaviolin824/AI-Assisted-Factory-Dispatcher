flowchart TB
    CORE["Shared deterministic allocation logic<br/>Same workshop eligibility and calculation responsibility"]
    subgraph LIVE["LIVE APPLICATION PATH - PLANNED"]
        CHAT["Operations messages and corrections"]
        LG["LangGraph intake, verification and review routing"]
        ADAPTER["Live adapter<br/>Current order status, assignments and queue state<br/>May require review instead of allocation"]
        PREVIEW["Decision preview<br/>Dispatcher feedback and confirmation policy"]
        COMMIT["Transactional committed assignment"]
        CHAT --> LG --> ADAPTER
        PREVIEW --> COMMIT
    end
    ADAPTER --> CORE --> PREVIEW

    subgraph HIST["HISTORICAL SCHEDULER EVALUATION - implemented separate adapter"]
        DATA[("Supplied 120 orders and 8 workshops<br/>Historical replay includes completed orders")]
        HARNESS["Unchanged harness/simulate.py<br/>Arrival-order replay, dynamic queues,<br/>seeded defects and workshop shock"]
        HA["Benchmark adapter - CURRENT<br/>Return exactly one eligible workshop per batch<br/>Prefer on-time options; otherwise choose least late<br/>Use the app's unrounded feasibility check"]
        METRICS["Six official metrics, unchanged<br/>Mean delivery days; P90 delivery days<br/>Percentage late; percentage defective<br/>Total cost; maximum workshop share"]
        EXTRA["Separate external evaluator<br/>Mean/P90/total tardiness and late-batch severity<br/>Optional piece-days late; clearly external"]
        COMPARE["Repeatable policy comparisons<br/>Supplied random, highest-capacity and cheapest baselines<br/>Primary, alternative and hybrid objectives; normal and shock runs"]
        DATA --> HARNESS -->|Batch and simulated queue| HA
        HA -->|Workshop choice| HARNESS
        HARNESS --> METRICS --> COMPARE
        HARNESS -->|Same replay outcomes; separate calculation| EXTRA --> COMPARE
    end
    HA -->|Invoke same core through benchmark contract| CORE
    CORE -->|One eligible workshop through adapter| HA

    subgraph QUALITY["REQUEST, WORKFLOW AND EXPLANATION EVALUATION"]
        REQUESTS[("30 supplied noisy requests plus unseen cases<br/>Frozen human-reviewed expected behavior")]
        INTERPRET["Intake/decision checks<br/>Intent, identity, evidence, corrections,<br/>constraints, clarification and unsupported outcomes"]
        GRAPH["Workflow checks<br/>CURRENT: offline graph routing and failure tests<br/>PLANNED: reply identity, restart/resume,<br/>stale previews and transaction failure"]
        EXPLAIN["Explanation checks<br/>Stored-record groundedness and factual consistency<br/>New calculations use deterministic tools"]
        SEMANTIC["Planned semantic evaluation support<br/>DeepEval reference code added; not integrated<br/>Human rubric first; judges cannot prove arithmetic"]
        LATENCY["Separate software measures<br/>Model/API latency, calls and token use<br/>Distinct from production delivery performance"]
        REQUESTS --> INTERPRET
        REQUESTS --> GRAPH
        REQUESTS --> EXPLAIN
        INTERPRET --> SEMANTIC
        EXPLAIN --> SEMANTIC
        LG -.->|Execution traces| GRAPH
        LG -.->|Measured software timings| LATENCY
    end
    REPORT["Evidence-backed project report and landing page<br/>Frozen baseline versus final; versions and assumptions<br/>Failure analysis, limitations and reproducible records<br/>Counts and controlled checks are not accuracy scores"]
    COMPARE --> REPORT
    INTERPRET --> REPORT
    GRAPH --> REPORT
    SEMANTIC --> REPORT
    LATENCY --> REPORT

    classDef frontend fill:#e6f0ff,stroke:#3773b9,color:#142e51;
    classDef langgraph fill:#eee7fb,stroke:#7750ad,color:#382454;
    classDef code fill:#e1f3ed,stroke:#27806a,color:#163f35;
    classDef human fill:#fff0d5,stroke:#b27a22,color:#563b15;
    classDef store fill:#edf0f4,stroke:#718096,color:#293444;
    classDef planned stroke-dasharray:5 4;
    class CHAT,REPORT frontend;
    class LG,GRAPH langgraph;
    class CORE,ADAPTER,COMMIT,HARNESS,HA,METRICS,EXTRA,COMPARE,INTERPRET,EXPLAIN,SEMANTIC,LATENCY code;
    class PREVIEW human;
    class DATA,REQUESTS store;
    class CHAT,LG,ADAPTER,PREVIEW,COMMIT,SEMANTIC planned;
    style LIVE fill:#f7f2ff,stroke:#7750ad,stroke-dasharray:5 4
    style HIST fill:#f1faf6,stroke:#27806a
    style QUALITY fill:#f7f8fa,stroke:#c1c9d4
